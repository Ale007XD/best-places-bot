# Скопируйте этот файл в .env и заполните значения:
#   cp .env.example .env
#
# Все переменные ниже обязательны (bot/config.py: Settings без default —
# отсутствие любой из них уронит контейнер на старте с pydantic.ValidationError).

# Токен Telegram-бота. Получить: @BotFather в Telegram → /newbot
BOT_TOKEN=

# Foursquare Places API — рейтинг + обогащение (foursquare_api.py).
# Получить: https://foursquare.com/developers/ → Developer Console →
# Manage API Keys → Service Key (Bearer-токен, не Client ID/Secret).
FSQ_API_KEY=

# Mapbox — основной поиск POI (mapbox_api.py).
# Получить: https://account.mapbox.com/access-tokens/
MAPBOX_TOKEN=

# VietMap — fallback для Вьетнама (vietmap_api.py).
# Самостоятельной выдачи ключей нет — писать напрямую в vietmap.vn.
VIETMAP_API_KEY=

# Числовой Telegram user_id администратора (для /feedback и уведомлений).
# Узнать свой ID: @userinfobot в Telegram.
ADMIN_ID=
