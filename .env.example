# Скопируйте этот файл в .env и заполните значения:
#   cp .env.example .env
#
# Для запуска ОБЯЗАТЕЛЬНЫ только BOT_TOKEN и FSQ_API_KEY. Но базовый слой поиска (без рейтингов)
# работает на Geoapify — задайте ещё и GEOAPIFY_API_KEY (ниже), иначе он пропускается.
# Пустое значение (`MAPBOX_TOKEN=`) = «не задано».

# --- обязательные ---

# Токен Telegram-бота. Получить: @BotFather в Telegram → /newbot
BOT_TOKEN=

# Foursquare Places API — слой с рейтингами и фото (Premium-поля) и запасной базовый слой;
# каждый запрос живой, без кэша (bot/utils/foursquare_api.py).
# Получить: https://foursquare.com/developers/ → Developer Console →
# Manage API Keys → Service Key (передаётся как Bearer-токен).
FSQ_API_KEY=

# --- опционально ---

# Версия Foursquare Places API (заголовок X-Places-Api-Version).
# FSQ_API_VERSION=2025-06-17

# Числовой Telegram user_id администратора: включает /feedback и /stats.
# Узнать свой ID: @userinfobot в Telegram.
ADMIN_ID=

# Аварийные фолбэки — только если ни один основной провайдер не дал мест.
# Mapbox: https://account.mapbox.com/access-tokens/
MAPBOX_TOKEN=

# Redis (по умолчанию — сервис redis из docker-compose)
# REDIS_URL=redis://redis:6379/0

# Значения по умолчанию на экране параметров. Радиус — одно из 100 / 200 / 500 / 1000 м;
# другие значения (и старые 2000/3000 из прежних версий) заменяются на 200.
# Если мест меньше трёх, бот сам расширяет радиус (100→200→300→500→1000) — без новых запросов.
# DEFAULT_RADIUS=200
# DEFAULT_MIN_RATING=4.0

# --- монетизация и геймификация (все значения ниже — по умолчанию) ---

# Монетизация по умолчанию ВЫКЛЮЧЕНА. Включить/выключить без перезапуска: команда /money on|off
# (админ, ADMIN_ID). Эта переменная — только стартовое значение до первой команды.
# QUOTA_ENABLED=false
# Тизер: поисков С РЕЙТИНГАМИ и ФОТО в день бесплатно (Premium-поля Foursquare — платные).
# Дальше — базовая выдача без них. Меняется на лету: /money free N
# FREE_SEARCHES_PER_DAY=1
# BASE_DAILY_LIMIT=30           # потолок базовых поисков в день
# PRO_DAILY_LIMIT=100
# STREAK_BONUS_CAP=2            # макс. прибавка к дневному лимиту поисков с рейтингами за серию
# QUOTA_UTC_OFFSET_HOURS=7      # когда начинается новый день (7 = Вьетнам)
# REFERRAL_BONUS=5              # бонусных поисков обоим за приглашённого
# REFERRAL_MAX_REWARDED=20

# Цены в Telegram Stars
# STARS_PRICE_PACK20=50
# STARS_PRICE_PRO_WEEK=100
# STARS_PRICE_PRO_MONTH=300
# STARS_PRICE_FREEZE=15

# --- базовый слой: Geoapify (данные OSM), без рейтингов ---
# Ключ: https://www.geoapify.com (бесплатно 3 000 кредитов/день). Без ключа провайдер пропускается.
# GEOAPIFY_API_KEY=
# Порядок провайдеров БАЗОВОГО поиска. Один запрос обслуживается ОДНИМ провайдером (без
# смешивания источников). Ответы Foursquare не кэшируются (правила Foursquare); данные
# Geoapify/Overpass (OSM) кэшируются по ячейке ~100 м на OSM_CACHE_TTL секунд.
# BASE_PROVIDERS=geoapify,fsq,overpass
# OSM_CACHE_TTL=86400

# --- фолбэк на OpenStreetMap (Overpass): бесплатно, без ключа, места без рейтинга ---
# OVERPASS_ENABLED=true
# Адреса через запятую, пробуются ПО ОЧЕРЕДИ; не ответивший сервер уходит на паузу на 90 с.
# По умолчанию — глобальные публичные серверы из вики OSM (основной, VK Maps, private.coffee,
# Япония). Если вы раньше раскомментировали здесь старую строку с kumi.systems — удалите её
# (он теперь называется overpass.private.coffee). Проверка: /diag в боте или
#   docker compose exec telegram-bot python -m bot.diag
# OVERPASS_URL=https://overpass-api.de/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter,https://overpass.private.coffee/api/interpreter,https://overpass.osm.jp/api/interpreter

# --- «был здесь» 👍/👎 и поиск по адресу ---
# VOTE_REWARD_EVERY=3           # каждые N новых отметок = +1 бонусный поиск (0 = выкл.)
# VOTE_REWARD_DAILY_CAP=3
# GEOCODER_ENABLED=true         # адрес/название → точка через OpenStreetMap Nominatim
# GEOCODER_URL=https://nominatim.openstreetmap.org/search

# --- карточки ---
# PHOTOS_ENABLED=true            # фото мест (реальные — только для «богатых» поисков; иначе заглушки)
# RESULTS_LAYOUT=cards           # cards — фото-карточки; compact — одно сообщение. На лету: /layout

# --- inline-режим (@бот в любом чате) ---
# INLINE_RESULTS=3              # сколько ближайших мест показывать
# INLINE_DEFAULT_RADIUS=200     # радиус без токена в запросе и без user_prefs (100/200/500/1000)
# INLINE_MAX_RADIUS=1000        # потолок токена радиуса («10км» прилипает вниз)
# LASTLOC_TTL_HOURS=6           # сколько живёт «последняя геопозиция» для inline на Desktop

# --- закрытые места ---
# Foursquare отдаёт date_closed (закрыто навсегда) — такие места отбрасываются сами. Кроме того,
# под местом есть кнопка «🚫 Закрыто»: место скрывается из выдачи после N жалоб РАЗНЫХ людей
# (админ — сразу) на CLOSED_TTL_DAYS дней, потом возвращается.
# CLOSED_REPORTS_THRESHOLD=2
# CLOSED_TTL_DAYS=60

# --- «Что попробовать здесь» (bot/data/specialties.json) ---
# Блюда с verified=false скрыты от пользователей. true — только чтобы самому посмотреть карточки,
# пока словарь не вычитан (после вычитки: verified=true + ссылки в sources).
# SPECIALTIES_SHOW_UNVERIFIED=false
